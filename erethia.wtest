import rolando.*

describe "Erethia" {
  test "la mochila de Rolando" {
    rolando.encontrar(espadaDelDestino)
    rolando.encontrar(libroDeHechizos)
    rolando.encontrar(collarDivino)
    assert.equals(#{espadaDelDestino, libroDeHechizos}, mochila.artefactos())
  }
  
  test "volver a casa" {
    rolando.encontrar(espadaDelDestino)
    rolando.encontrar(libroDeHechizos)
    rolando.llegadaAlHogar()
    rolando.encontrar(collarDivino)
    rolando.llegadaAlHogar()
    assert.equals(
      #{espadaDelDestino, libroDeHechizos, collarDivino},
      castilloDePiedra.almacen()
    )
  }
  
  test "mis artefactos" {
    castilloDePiedra.almacen([espadaDelDestino, collarDivino])
    rolando.encontrar(armaduraDeAceroValyrio)
    assert.equals(
      #{armaduraDeAceroValyrio, espadaDelDestino, collarDivino},
      rolando.artefactosEnTotal()
    )
  }
  
  test "historial de encuentros" {
    rolando.encontrar(espadaDelDestino)
    rolando.encontrar(libroDeHechizos)
    rolando.encontrar(collarDivino)
    rolando.llegadaAlHogar()
    rolando.encontrar(armaduraDeAceroValyrio)
    rolando.encontrar(collarDivino)
    assert.equals(
      [   
        espadaDelDestino,
        libroDeHechizos,
        collarDivino,
        armaduraDeAceroValyrio,
        collarDivino
      ],
      rolando.encuentros()
    )
  }
  
  test "la batalla!!" {
    mochila.capacidadDeMochi(3)
    rolando.poderBase(5)
    mochila.artefactos(#{espadaDelDestino, armaduraDeAceroValyrio, collarDivino})
    assert.equals(19, rolando.poderDeBatalla())
  }
  
  test "muchas batallas" {
    mochila.capacidadDeMochi(3)
    rolando.poderBase(5)
    mochila.artefactos(#{espadaDelDestino, armaduraDeAceroValyrio, collarDivino})
    assert.equals(5, espadaDelDestino.poderAportado(rolando))
    assert.equals(6, armaduraDeAceroValyrio.poderAportado(rolando))
    assert.equals(3, collarDivino.poderAportado(rolando))
    rolando.batalla()
    assert.equals(3, espadaDelDestino.poderAportado(rolando))
    assert.equals(6, armaduraDeAceroValyrio.poderAportado(rolando))
    assert.equals(3, collarDivino.poderAportado(rolando))
    assert.equals(6, rolando.poderBase())
    rolando.batalla()
    assert.equals(3.5, espadaDelDestino.poderAportado(rolando))
    assert.equals(6, armaduraDeAceroValyrio.poderAportado(rolando))
    assert.equals(5, collarDivino.poderAportado(rolando))
    assert.equals(7, rolando.poderBase())
    rolando.batalla()
    assert.equals(4, espadaDelDestino.poderAportado(rolando))
    assert.equals(6, armaduraDeAceroValyrio.poderAportado(rolando))
    assert.equals(6, collarDivino.poderAportado(rolando))
    assert.equals(8, rolando.poderBase())
  }
  test "libro de hechizardos" {
    libroDeHechizos.hechizos.addAll([bendición,invisibilidad,invocación])
    rolando.poderBase(5)
    castilloDePiedra.almacen.addAll(#{espadaDelDestino,armaduraDeAceroValyrio,collarDivino})
    mochila.artefactos.add(libroDeHechizos)
    assert.equals(4, libroDeHechizos.poderAportado(rolando))
    rolando.batalla()
    assert.equals(6, libroDeHechizos.poderAportado(rolando))

  }
}